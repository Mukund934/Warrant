# Names only. Never commit values.

# The Warrant API this site records against. Server-only: read inside route handlers and server
# components, never shipped to the browser. It must never gain a NEXT_PUBLIC_ prefix.
WARRANT_API_URL=

# Sign-in. Both are browser-visible by design — they are inlined into the client bundle and cannot
# be recalled, which is why only these two ever earn the prefix. Leave both blank to run without
# sign-in: the demonstrator, the docs and the offline verifier all work without an identity provider.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
